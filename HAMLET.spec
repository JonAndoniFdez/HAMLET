# -*- mode: python ; coding: utf-8 -*-

import base64
from fnmatch import fnmatch
from pathlib import Path
import runpy
import importlib.util
import os
import sys
import hashlib
import json
import zlib
from PyInstaller.utils.hooks import collect_submodules, collect_data_files

project = Path(SPECPATH).resolve()
# DLL discovery must not see unrelated desktop-tool runtimes. In particular,
# ICU from Poppler is not Windows' system ICU, although both use icuuc.dll.
windows = Path(os.environ['WINDIR'])
os.environ['PATH'] = os.pathsep.join(map(str, [Path(sys.base_prefix), Path(sys.base_prefix) / 'DLLs', windows / 'System32', windows]))

excluded_blender_payload_files = {
    "blender/generate_markers_template.py",
}


def discover_blender_payload_files() -> list[str]:
    assets_dir = project / "src" / "assets"
    if not assets_dir.exists():
        raise FileNotFoundError(f"Source assets directory not found: {assets_dir}")

    files: list[str] = []
    blender_scripts_dir = assets_dir / "blender"
    if blender_scripts_dir.exists():
        for script_path in sorted(blender_scripts_dir.glob("*.py")):
            rel_path = f"blender/{script_path.name}"
            if rel_path not in excluded_blender_payload_files:
                files.append(rel_path)

    shared_utils = assets_dir / "blender_texture_material_utils.py"
    if shared_utils.exists():
        files.append("blender_texture_material_utils.py")

    return files


def build_blender_payload_module() -> Path:
    generated_dir = project / "build" / "generated"
    generated_dir.mkdir(parents=True, exist_ok=True)

    payload = {}
    assets_dir = project / "src" / "assets"
    for rel_path in discover_blender_payload_files():
        source_path = assets_dir / rel_path
        if not source_path.exists():
            raise FileNotFoundError(f"Required Blender payload file not found: {source_path}")
        compressed = zlib.compress(source_path.read_bytes(), level=9)
        payload[rel_path] = base64.b64encode(compressed).decode("ascii")

    module_path = generated_dir / "hamlet_blender_payload.py"
    module_path.write_text(
        "# Generated by HAMLET.spec during PyInstaller build.\n"
        "# Contains compressed Blender runtime scripts for temporary extraction.\n\n"
        f"SCRIPTS = {payload!r}\n",
        encoding="utf-8",
    )
    return generated_dir


generated_dir = build_blender_payload_module()
build_inputs = [project / 'run_app.py', project / 'HAMLET.spec', project / 'requirements-release.lock.txt',
                project / 'tools/release_license_files.py', project / 'version_info.txt',
                project / 'LICENSE.txt', project / 'NOTICE.txt', project / 'CITATION.cff']
build_inputs += list((project / 'src').rglob('*.py'))
build_inputs += list((project / 'tools/pyinstaller_hooks').glob('*.py'))
input_manifest = generated_dir / 'build-inputs.json'
input_manifest.write_text(json.dumps({p.relative_to(project).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
                                     for p in sorted(build_inputs)}, indent=2), encoding='utf-8')


def _dest(*parts: str) -> str:
    return str(Path(*parts)).replace("\\", "/")


def _is_excluded(path: Path, patterns: list[str]) -> bool:
    rel = path.as_posix()
    name = path.name
    return any(fnmatch(rel, pattern) or fnmatch(name, pattern) for pattern in patterns)


def collect_project_tree(root: Path, dest: str, excludes: list[str] | None = None) -> list[tuple[str, str]]:
    """Collect a data tree while keeping release-only exclusions explicit."""
    if not root.exists():
        return []

    excludes = excludes or []
    collected: list[tuple[str, str]] = []

    for file_path in root.rglob("*"):
        if not file_path.is_file():
            continue

        rel = file_path.relative_to(root)
        if _is_excluded(rel, excludes):
            continue

        collected.append((str(file_path), _dest(dest, str(rel.parent))))

    return collected


hiddenimports = [
    "hamlet_blender_payload",
    "PySide6.QtCore",
    "PySide6.QtGui",
    "PySide6.QtWidgets",
    "PySide6.QtWebChannel",
    "PySide6.QtWebEngineCore",
    "PySide6.QtWebEngineWidgets",
    "vtkmodules.qt.QVTKRenderWindowInteractor",
]

hiddenimports += collect_submodules("src")
hiddenimports += collect_submodules("vedo")
hiddenimports += collect_submodules("vtkmodules")
hiddenimports += collect_submodules("openpyxl")

datas = []
datas.append((str(input_manifest), '.'))

datas += collect_data_files("vedo")

for legal_file in [
    "LICENSE.txt",
    "NOTICE.txt",
    "THIRD_PARTY_NOTICES.md",
    "RELEASE_LEGAL_CHECKLIST.md",
    "SOURCE_CODE.md",
    "README_RELEASE.txt",
    "CITATION.cff",
    "OPENPOSE_MODELS_NOTICE.txt",
    "docs/README.pdf",
]:
    p = project / legal_file
    if p.exists():
        datas.append((str(p), str(Path(legal_file).parent)))

assets_dir = project / "src" / "assets"
datas += collect_project_tree(
    assets_dir,
    "assets",
    excludes=[
        "__pycache__/*",
        "*.pyc",
        "*.pyo",
        "blender/*.py",
        "blender_texture_material_utils.py",
        "scripts/detect_map_worker.py",
        "scripts/interactive_label_editor.py",
    ],
)

blender_dir = project / "blender"
blender_datas = collect_project_tree(
    blender_dir,
    "blender",
    excludes=[
        "__pycache__/*",
        "*.pyc",
        "*.pyo",
        "*.pdb",
        "*.lib",
        "blender_debug*.cmd",
        "pi_win_proxy_loaderd.dll",
    ],
)

openpose_hand_dir = project / "openpose" / "models" / "hand"

for fname in [
    "pose_deploy.prototxt",
    "pose_iter_102000.caffemodel",
]:
    p = openpose_hand_dir / fname
    if p.exists():
        datas.append((str(p), "openpose/models/hand"))

# Preserve upstream terms when bundling models. This is attribution only;
# permission to redistribute the models must still be confirmed before release.
if any(openpose_hand_dir.glob("*.caffemodel")):
    openpose_license = project / "openpose" / "LICENSE"
    if not openpose_license.is_file():
        raise FileNotFoundError("Bundled OpenPose models require openpose/LICENSE")
    datas.append((str(openpose_license), "openpose"))
    openpose_version = project / "openpose" / "Version.txt"
    if openpose_version.is_file():
        datas.append((str(openpose_version), "openpose"))

excludes = [
    "PyQt5",
    "PyQt6",
    "tkinter",
    "matplotlib",
    "IPython",
    "ipykernel",
    "jedi",
    "jupyter_client",
    "jupyter_core",
    "nbformat",
    "notebook",
    "plotly",
    "debugpy",
    "pytest",
    "setuptools.tests",
]

# HAMLET uses Widgets and WebEngine, not an application QML scene. Keep native
# dependencies discovered by the hooks, but do not import unrelated bindings.
qt_bindings = {
    "QtCore", "QtGui", "QtWidgets", "QtNetwork", "QtPrintSupport",
    "QtOpenGL", "QtOpenGLWidgets", "QtQml", "QtQuick", "QtQuickWidgets",
    "QtPositioning", "QtWebChannel", "QtWebEngineCore", "QtWebEngineWidgets",
    "QtSvg", "QtSvgWidgets",
}
qt_package = Path(importlib.util.find_spec("PySide6").origin).parent
for binding in qt_package.glob("Qt*.pyd"):
    if binding.stem not in qt_bindings:
        excludes.extend([f"PySide6.{binding.stem}", f"qtpy.{binding.stem}"])


a = Analysis(
    [str(project / "run_app.py")],
    pathex=[str(project), str(generated_dir)],
    binaries=[(str(p), ".") for pattern in ("MSVCP140*.dll", "VCRUNTIME140*.dll")
              for p in qt_package.glob(pattern)],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[str(project / "tools" / "pyinstaller_hooks")],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
    optimize=0,
)

# Select notices from this build's actual inputs, not a stale audit folder.
license_collector = runpy.run_path(str(project / "tools" / "release_license_files.py"))
a.datas += license_collector["collect_license_files"](
    [*a.pure, *a.binaries, *a.datas],
    generated_dir,
    project / "third_party_licenses",
)

# Blender is a separate executable, not a Python extension of HAMLET. Keeping
# its runtime out of Analysis prevents dependency scanning from copying its
# older C++ libraries and unrelated DLLs into HAMLET's loader search directory.
a.datas += [(_dest(dest, Path(source).name), source, "DATA") for source, dest in blender_datas]
# No HAMLET workflow reads or writes video; OpenCV image and DNN functionality
# does not need its optional FFmpeg video-I/O plugin. Blender/WebEngine keep
# their own, separately licensed FFmpeg components.
a.binaries = [entry for entry in a.binaries
              if not Path(entry[0]).name.lower().startswith("opencv_videoio_ffmpeg")
              and Path(entry[0]).name.lower() != "opengl32sw.dll"]
for destination, source, kind in a.binaries:
    origin = Path(source).resolve()
    if not (origin.is_relative_to(project) or origin.is_relative_to(Path(sys.base_prefix))):
        raise RuntimeError(f"Uncontrolled external binary selected: {destination} <- {source}")

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="HAMLET",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    version=str(project / "version_info.txt"),

    # Evita que todo se meta dentro de _internal
    contents_directory=".",

    # Si quieres añadir icono, puedes activar esta línea:
    # icon=str(project / "src" / "assets" / "icons" / "uji_icon.ico"),
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="HAMLET",
)
